# Copy to .env and adjust values: cp .env.example .env
# NOTE: Skeleton only. Variables are reserved for future implementation.

# ---- Compose ----
COMPOSE_PROJECT_NAME=smart-youtube-face-control

# ---- MQTT Broker ----
MQTT_PORT=1883
# MQTT_WS_PORT=9001          # Reserved: MQTT over WebSocket (disabled by default)

# ---- MQTT Topics ----
MQTT_TOPIC_PREFIX=smart-media
DEVICE_ID=xiao-01

# ---- Control Gateway ----
GATEWAY_PORT=8000
MQTT_HOST=mqtt-broker
DEVICE_TIMEOUT_MS=3000       # Reserved: device heartbeat timeout

# ---- Web UI ----
WEB_UI_PORT=8080
GATEWAY_WS_URL=ws://localhost:8000/ws
YOUTUBE_VIDEO_ID=

# ---- Model Benchmark (profile: benchmark) ----
BENCHMARK_RESULTS_DIR=/app/results
