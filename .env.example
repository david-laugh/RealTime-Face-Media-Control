# Copy to .env and adjust values: cp .env.example .env

# ---- Compose ----
COMPOSE_PROJECT_NAME=smart-youtube-face-control

# ---- MQTT Broker ----
MQTT_PORT=1883
# MQTT_WS_PORT=9001          # Reserved: MQTT over WebSocket (disabled by default)

# ---- MQTT Topics ----
MQTT_TOPIC_PREFIX=smart-media
DEVICE_ID=xiao-01

# ---- Control Gateway ----
# The gateway always connects to the broker as mqtt-broker:1883 inside Docker.
# (The ESP32 uses the host PC LAN IP, configured in firmware config.h.)
GATEWAY_PORT=8000
# Device timeout = 2.5x the 10 s mock publish interval
DEVICE_TIMEOUT_MS=25000
# Debounce: a PLAY/PAUSE switch needs COUNT consecutive detections spanning >= MS.
# 1 / 0 = off (mock demo default). Real values come from the model benchmark; not tuned yet.
# Fail-safe PAUSE (timeout / offline / broker down) is never debounced.
PLAY_CONFIRM_COUNT=1
PLAY_CONFIRM_MS=0
PAUSE_CONFIRM_COUNT=1
PAUSE_CONFIRM_MS=0
LOG_LEVEL=INFO

# ---- Web UI ----
WEB_UI_PORT=8080
GATEWAY_WS_URL=ws://localhost:8000/ws/media
YOUTUBE_VIDEO_ID=

# ---- Model Benchmark (profile: benchmark) ----
BENCHMARK_RESULTS_DIR=/app/results
