{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-youtube-face-control/contracts/mqtt/detection.schema.json",
  "title": "MQTT Detection Message",
  "description": "Topic: smart-media/{device_id}/detection. Published by XIAO ESP32S3 Sense. QoS 0, retain=false. Face presence only; PLAY/PAUSE is decided by the Control Gateway. Mock and real providers share this contract.",
  "type": "object",
  "required": [
    "schema_version",
    "device_id",
    "seq",
    "uptime_ms",
    "source",
    "model_id",
    "raw_face_detected"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must match {device_id} in the topic."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Incremented on every publish. Resets on device reboot."
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Device millis() at publish time."
    },
    "source": {
      "type": "string",
      "enum": ["mock", "edge_impulse"],
      "description": "Detection provider. 'mock' = alternating true/false without camera/model."
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "'mock-v1' for the mock provider, Edge Impulse model id later."
    },
    "raw_face_detected": {
      "type": "boolean",
      "description": "Whether a face is present in the frame."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Optional. Real model only. MUST NOT be sent by the mock provider."
    },
    "inference_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional. Real model only. MUST NOT be sent by the mock provider."
    },
    "bbox": {
      "type": "object",
      "description": "Optional. Real model only. Normalized (0..1) bounding box.",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "h": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": "1.0",
      "device_id": "xiao-01",
      "seq": 1,
      "uptime_ms": 10000,
      "source": "mock",
      "model_id": "mock-v1",
      "raw_face_detected": true
    },
    {
      "schema_version": "1.0",
      "device_id": "xiao-01",
      "seq": 2,
      "uptime_ms": 20000,
      "source": "mock",
      "model_id": "mock-v1",
      "raw_face_detected": false
    }
  ]
}
